{% extends "layouts/section.twig" %}

{% block content %}
    {% include "components/intro.twig" with {
        intro: intro,
    } %}

    {% if slides %}
        <div class="section section--large">
            <div class="mb-small">
                <div class="pills">
                    {% for slide in slides %}
                        {% if slide.title %}
                            <a class="pills__item {{ loop.index == 1 ? 'active' : '' }}" href="#" data-slider-paginate-for="logo-slides-{{ html_id | e }}" data-slider-paginate-to="{{ loop.index0 }}">
                                {{ slide.title }}
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            <div class="flickity flickity--logos" data-slider data-name="logo-slides-{{ html_id | e }}" data-settings='{"draggable": false, "wrapAround": true, "counter": false, "pageDots": false, "progressBar": false, "prevNextButtons": false}'>
                {% for slide in slides %}
                    <div class="flickity__item">
                        <div class="logos logos--alt" data-animate="logos">
                            {% for logo in slide.logos %}
                                {% set image = cms_image(logo.img ?: [], 'Logo') %}

                                {% if image %}
                                    {% set image_with_link = Link(logo.link).setText(image) %}
                                    <div class="logos__item">
                                        {% if image_with_link.isSetup() %}
                                            {{ image_with_link.render() | raw }}
                                        {% else %}
                                            <span>
                                                {{ image | raw }}
                                            </span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}
