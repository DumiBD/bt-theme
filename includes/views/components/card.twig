<div class="card">
    {% if image %}
        <div class="card__media">
            {{ image | raw }}
        </div>
    {% endif %}

    <div class="card__content">
        <div class="txt-styles">
            {{ txt | wysiwyg }}
        </div>

        {% if link.isSetup() %}
            <div class="mt-mini">
                {{ link.render() | raw }}
            </div>
        {% endif %}
    </div>
</div>
