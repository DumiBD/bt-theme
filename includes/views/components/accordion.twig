{% if accordion %}
    {% for row in accordion %}
        {% if row.title and row.txt %}
            {% set row_id = "accordion-" ~ random() ~ "-" ~ loop.index %}

            <div class="accordion">
                <div class="accordion__header" data-toggle-target="{{ row_id | e }}">
                    <h3 class="accordion__title">
                        {% if numbered %}
                            <span class="accordion__number">{{ loop.index }}.</span>
                        {% endif %}

                        {{ row.title }}
                    </h3>

                    <span class="accordion__action">
                        {{ svg('plus', 'icons') }}
                    </span>
                </div>

                <div class="accordion__content" data-toggle="{{ row_id | e }}">
                    <div class="txt-styles">
                        {{ row.txt | wysiwyg }}
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}
{% endif %}
